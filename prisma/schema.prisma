generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubjectType {
  THEORY
  PRACTICAL
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum OverrideType {
  TEMPORARY
  PERMANENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  majors Major[]
}

model Major {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
}

model Level {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]
}

model Group {
  id               Int               @id @default(autoincrement())
  name             String
  students         Student[]
  schedules        Schedule[]
  notificationLogs NotificationLog[]
}

model Student {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  idNumber         String             @unique
  idPhotoUrl       String?
  phone            String             @unique
  isEmailVerified  Boolean            @default(false)
  isPhoneVerified  Boolean            @default(false)
  majorId          Int
  major            Major              @relation(fields: [majorId], references: [id])
  levelId          Int
  level            Level              @relation(fields: [levelId], references: [id])
  groupId            Int
  group              Group              @relation(fields: [groupId], references: [id])
  notificationLogs   NotificationLog[]
  verificationCodes  VerificationCode[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime           @default(now())
}

model Subject {
  id        Int         @id @default(autoincrement())
  name      String
  code      String      @unique
  type      SubjectType
  schedules Schedule[]
}

model Room {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  capacity           Int
  schedules          Schedule[]
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
}

model Lecturer {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  phone              String?
  schedules          Schedule[]
  rescheduleRequests RescheduleRequest[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime            @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RescheduleRequest {
  id           Int           @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule      @relation(fields: [scheduleId], references: [id])
  lecturerId   Int
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id])
  requestType  String        // 'CANCEL' or 'RESCHEDULE'
  newDayOfWeek DayOfWeek?
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?         @relation(fields: [newRoomId], references: [id])
  reason       String?
  status       RequestStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime      @default(now())
}

model Schedule {
  id                 Int                @id @default(autoincrement())
  subjectId          Int
  subject            Subject            @relation(fields: [subjectId], references: [id])
  roomId             Int
  room               Room               @relation(fields: [roomId], references: [id])
  lecturerName       String
  lecturerId         Int?
  lecturer           Lecturer?          @relation(fields: [lecturerId], references: [id])
  groupId            Int
  group              Group              @relation(fields: [groupId], references: [id])
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
}

model ScheduleOverride {
  id           Int          @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule     @relation(fields: [scheduleId], references: [id])
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?        @relation(fields: [newRoomId], references: [id])
  date         DateTime
  overrideType OverrideType
}

model NotificationLog {
  id        Int                @id @default(autoincrement())
  studentId Int?
  student   Student?           @relation(fields: [studentId], references: [id])
  groupId   Int?
  group     Group?             @relation(fields: [groupId], references: [id])
  message   String
  sentTime  DateTime           @default(now())
  status    NotificationStatus
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              AdminRole          @default(ADMIN)
  pushSubscriptions PushSubscription[]
}

enum VerificationType {
  EMAIL
  PHONE
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String
  type      VerificationType
  expiresAt DateTime
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  studentId  Int?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  lecturerId Int?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
}

