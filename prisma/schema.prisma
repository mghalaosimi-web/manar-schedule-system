generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubjectType {
  THEORY
  PRACTICAL
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum OverrideType {
  TEMPORARY
  PERMANENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id])
  majors    Major[]
}

model Major {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
}

model Level {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]
}

model Group {
  id               Int               @id @default(autoincrement())
  name             String
  students         Student[]
  schedules        Schedule[]
  notificationLogs NotificationLog[]
  examSchedules    ExamSchedule[]
  collegeId        Int
  college          College           @relation(fields: [collegeId], references: [id])
}

model Student {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  idNumber         String             @unique
  idPhotoUrl       String?
  phone            String             @unique
  isEmailVerified  Boolean            @default(false)
  isPhoneVerified  Boolean            @default(false)
  collegeId        Int
  college          College            @relation(fields: [collegeId], references: [id])
  majorId          Int
  major            Major              @relation(fields: [majorId], references: [id])
  levelId          Int
  level            Level              @relation(fields: [levelId], references: [id])
  groupId            Int
  group              Group              @relation(fields: [groupId], references: [id])
  notificationLogs   NotificationLog[]
  verificationCodes  VerificationCode[]
  pushSubscriptions  PushSubscription[]
  attendanceRecords  AttendanceRecord[]
  seatAllocations    SeatAllocation[]
  createdAt          DateTime           @default(now())
}

model Subject {
  id        Int         @id @default(autoincrement())
  name      String
  code      String      @unique
  type      SubjectType
  schedules Schedule[]
  examSchedules ExamSchedule[]
  collegeId Int
  college   College     @relation(fields: [collegeId], references: [id])
}

model Room {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  capacity           Int
  schedules          Schedule[]
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  examSchedules      ExamSchedule[]
  collegeId          Int
  college            College            @relation(fields: [collegeId], references: [id])
}

model Lecturer {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  phone              String?
  schedules          Schedule[]
  rescheduleRequests RescheduleRequest[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime            @default(now())
  collegeId          Int
  college            College             @relation(fields: [collegeId], references: [id])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RescheduleRequest {
  id           Int           @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule      @relation(fields: [scheduleId], references: [id])
  lecturerId   Int
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id])
  requestType  String        // 'CANCEL' or 'RESCHEDULE'
  newDayOfWeek DayOfWeek?
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?         @relation(fields: [newRoomId], references: [id])
  reason       String?
  status       RequestStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime      @default(now())
}

model Schedule {
  id                 Int                @id @default(autoincrement())
  subjectId          Int
  subject            Subject            @relation(fields: [subjectId], references: [id])
  roomId             Int
  room               Room               @relation(fields: [roomId], references: [id])
  lecturerName       String
  lecturerId         Int?
  lecturer           Lecturer?          @relation(fields: [lecturerId], references: [id])
  groupId            Int
  group              Group              @relation(fields: [groupId], references: [id])
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  attendanceRecords  AttendanceRecord[]
  collegeId          Int
  college            College            @relation(fields: [collegeId], references: [id])
}

model ScheduleOverride {
  id           Int          @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule     @relation(fields: [scheduleId], references: [id])
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?        @relation(fields: [newRoomId], references: [id])
  date         DateTime
  overrideType OverrideType
}

model NotificationLog {
  id        Int                @id @default(autoincrement())
  studentId Int?
  student   Student?           @relation(fields: [studentId], references: [id])
  groupId   Int?
  group     Group?             @relation(fields: [groupId], references: [id])
  message   String
  sentTime  DateTime           @default(now())
  status    NotificationStatus
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              AdminRole          @default(ADMIN)
  pushSubscriptions PushSubscription[]
  collegeId         Int?
  college           College?           @relation(fields: [collegeId], references: [id])
}

enum VerificationType {
  EMAIL
  PHONE
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String
  type      VerificationType
  expiresAt DateTime
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  studentId  Int?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  lecturerId Int?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model AttendanceRecord {
  id         Int              @id @default(autoincrement())
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId Int
  schedule   Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  scannedAt  DateTime         @default(now())

  @@unique([studentId, scheduleId, date])
}

model ExamSchedule {
  id              Int              @id @default(autoincrement())
  subjectId       Int
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomId          Int
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  groupId         Int
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String           // e.g. "09:00"
  endTime         String           // e.g. "11:00"
  seatAllocations SeatAllocation[]
  collegeId       Int
  college         College          @relation(fields: [collegeId], references: [id])
}

model SeatAllocation {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  seatNumber     String       // e.g. "Seat 1", "Seat 2"
  
  @@unique([studentId, examScheduleId])
  @@unique([examScheduleId, seatNumber])
}

model University {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  logoUrl    String?
  themeColor String?
  colleges   College[]
}

model College {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  location     String?
  universityId Int
  university   University     @relation(fields: [universityId], references: [id])
  departments  Department[]
  students     Student[]
  admins       Admin[]
  lecturers    Lecturer[]
  rooms        Room[]
  subjects     Subject[]
  groups       Group[]
  schedules    Schedule[]
  examSchedules ExamSchedule[]
}


